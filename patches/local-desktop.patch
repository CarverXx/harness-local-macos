diff --git a/apps/desktop/src/local-privacy.ts b/apps/desktop/src/local-privacy.ts
new file mode 100644
index 00000000..cacb72ec
--- /dev/null
+++ b/apps/desktop/src/local-privacy.ts
@@ -0,0 +1,67 @@
+/** Network and storage boundaries for the macOS local-model edition. */
+import { app } from 'electron'
+import { join } from 'node:path'
+import { existsSync, mkdirSync, readFileSync } from 'node:fs'
+import { homedir } from 'node:os'
+
+export function isLoopbackUrl(value: string | URL): boolean {
+  try {
+    const url = new URL(value)
+    return ['http:', 'https:', 'ws:', 'wss:'].includes(url.protocol)
+      && ['127.0.0.1', '[::1]', 'localhost'].includes(url.hostname)
+      && !url.username && !url.password
+  } catch { return false }
+}
+
+let hostPort: string | undefined
+
+/** Only the authenticated desktop Host may carry renderer traffic, including its multiplexed WebSocket. */
+export function setLocalHost(value: string): void {
+  const url = new URL(value)
+  if (!isLoopbackUrl(url) || url.protocol !== 'http:' || !url.port) throw Error('Expected a loopback desktop Host')
+  hostPort = url.port
+}
+
+export function isLocalHostUrl(value: URL): boolean {
+  return hostPort !== undefined && isLoopbackUrl(value) && value.port === hostPort
+}
+
+export function configureLocalDesktop(): void {
+  const root = join(homedir(), 'Library', 'Application Support', 'Local Harness')
+  for (const name of ['Electron', 'Harness', 'Agents', 'Workspaces']) mkdirSync(join(root, name), { recursive: true, mode: 0o700 })
+  app.setPath('userData', join(root, 'Electron'))
+  process.env.DSH_HOME = join(root, 'Harness')
+  process.env.DSH_AGENTS_HOME = join(root, 'Agents')
+  process.env.DSH_TELEMETRY_DISABLED = '1'
+  process.env.DSH_TELEMETRY_MODE = 'DISABLED'
+  const inferenceKey = join(root, 'Inference', 'inference.key')
+  process.env.DSH_LOCAL_MODEL_KEY = existsSync(inferenceKey) ? readFileSync(inferenceKey, 'utf8').trim() : ''
+  process.env.DSH_LOCAL_WORKSPACES = join(root, 'Workspaces')
+  // The proxy has no listener. Only loopback may bypass it, including IP literals.
+  app.commandLine.appendSwitch('proxy-server', 'http://127.0.0.1:0')
+  app.commandLine.appendSwitch('proxy-bypass-list', 'localhost;127.0.0.1;[::1]')
+  app.commandLine.appendSwitch('host-resolver-rules', 'MAP * ~NOTFOUND, EXCLUDE localhost, EXCLUDE 127.0.0.1, EXCLUDE [::1]')
+  app.commandLine.appendSwitch('disable-background-networking')
+  app.commandLine.appendSwitch('force-webrtc-ip-handling-policy', 'disable_non_proxied_udp')
+  app.on('session-created', (session) => {
+    session.webRequest.onBeforeRequest((details, reply) => {
+      const url = new URL(details.url)
+      const network = ['http:', 'https:', 'ws:', 'wss:', 'ftp:'].includes(url.protocol)
+      reply({ cancel: network && !isLocalHostUrl(url) })
+    })
+  })
+}
+
+/** Keep shell credentials and proxy settings outside the default Host environment. */
+export function localHostEnvironment(): NodeJS.ProcessEnv {
+  const names = [
+    'HOME', 'USER', 'LOGNAME', 'SHELL', 'PATH', 'TMPDIR', 'LANG', 'LC_ALL', 'LC_CTYPE', 'TZ',
+    'DSH_HOME', 'DSH_AGENTS_HOME', 'DSH_TELEMETRY_DISABLED', 'DSH_TELEMETRY_MODE',
+    'DSH_LOCAL_MODEL_KEY', 'DSH_LOCAL_WORKSPACES',
+  ]
+  const environment: NodeJS.ProcessEnv = {}
+  for (const name of names) {
+    if (process.env[name] !== undefined) environment[name] = process.env[name]
+  }
+  return environment
+}
